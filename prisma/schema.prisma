generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  EMAIL_CHANGE
  PASSWORD_RESET
}

enum AuthProvider {
  GOOGLE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum PropertyDataType {
  TEXT
  LONG_TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
  MULTI_SELECT
}

enum CoreFieldKey {
  TITLE
  DESCRIPTION
  IMAGES
  LOCATION
  QUANTITY
  EXPIRY
}

enum PropertyDefinitionStatus {
  ACTIVE
  INACTIVE
}

model User {
  id              String     @id @default(uuid())
  fullName        String
  email           String     @unique
  passwordHash    String?
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  isEmailVerified Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpVerifications OtpVerification[]
  userSessions     UserSession[]
  authAccounts     UserAuthAccount[]

  @@index([status])
  @@index([role])
}

model UserAuthAccount {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerAccountId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OtpVerification {
  id          String     @id @default(uuid())
  userId      String
  codeHash    String
  purpose     OtpPurpose
  expiresAt   DateTime
  attempts    Int        @default(0)
  resendCount Int        @default(0)
  verifiedAt  DateTime?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  description  String?
  parentId     String?
  status       CategoryStatus @default(ACTIVE)
  displayOrder Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  fields     CategoryField[]
  properties CategoryProperty[]

  @@index([parentId])
  @@index([status])
  @@index([parentId, displayOrder])
}

model PropertyDefinition {
  id               String                   @id @default(uuid())
  name             String
  slug             String                   @unique
  description      String?
  dataType         PropertyDataType
  validationConfig Json?
  status           PropertyDefinitionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options    PropertyOption[]
  categories CategoryProperty[]

  @@index([status])
  @@index([dataType])
}

model PropertyOption {
  id         String @id @default(uuid())
  propertyId String

  label        String
  value        String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property PropertyDefinition @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, value])
  @@index([propertyId])
  @@index([propertyId, displayOrder])
}

model CategoryProperty {
  id         String @id @default(uuid())
  categoryId String
  propertyId String

  required     Boolean @default(false)
  filterable   Boolean @default(false)
  sortable     Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  property PropertyDefinition @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([categoryId, propertyId])
  @@index([categoryId, displayOrder])
  @@index([propertyId])
}

model CategoryField {
  id         String       @id @default(uuid())
  categoryId String
  fieldKey   CoreFieldKey

  required     Boolean @default(false)
  isEnabled    Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, fieldKey])
  @@index([categoryId, displayOrder])
  @@index([fieldKey])
}
